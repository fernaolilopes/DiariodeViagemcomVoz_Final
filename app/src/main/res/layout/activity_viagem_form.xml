<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Cadastro de Viagem / Visita"
            android:textSize="20sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="16dp" />

        <EditText
            android:id="@+id/edtTitulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Título do Local / Viagem"
            android:inputType="textPersonName"
            android:layout_marginBottom="12dp" />

        <EditText
            android:id="@+id/edtData"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Data e Hora"
            android:inputType="text"
            android:layout_marginBottom="12dp" />

        <EditText
            android:id="@+id/edtObservacoes"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:gravity="top"
            android:hint="Observações e anotações da viagem..."
            android:inputType="textMultiLine"
            android:layout_marginBottom="12dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <Button
                android:id="@+id/btnGps"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Obter GPS"
                android:layout_marginEnd="4dp" />

            <Button
                android:id="@+id/btnGiroscopio"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Ler Giroscópio"
                android:layout_marginStart="4dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/txtGps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="GPS: Não capturado"
            android:textSize="14sp"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/txtGiroscopio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Sensor/Giroscópio: Não lido"
            android:textSize="14sp"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btnFoto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tirar Fotografia"
            android:layout_marginBottom="8dp" />

        <ImageView
            android:id="@+id/imgFoto"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:scaleType="centerCrop"
            android:background="#DDDDDD"
            android:layout_marginBottom="12dp"
            android:contentDescription="Foto do local" />

        <Button
            android:id="@+id/btnGravarAudio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Gravar Diário de Voz"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnTocarAudio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Reproduzir Áudio"
            android:enabled="false"
            android:layout_marginBottom="16dp" />

        <Button
            android:id="@+id/btnSalvar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Salvar Registro"
            android:backgroundTint="@android:color/holo_green_dark"
            android:textColor="@android:color/white" />

    </LinearLayout>
</ScrollView>
